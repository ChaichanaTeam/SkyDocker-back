{
    "version": 1,
    "disable_existing_loggers": false,
    "handlers":
    {
        "intercept":
        {
            "class": "backend_src.core.logger.InterceptHandler"
        }
    },
    "loggers":
    {
        "uvicorn":
        {
            "handlers": ["intercept"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.access":
        {
            "handlers": ["intercept"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.error": 
        {
            "handlers": ["intercept"],
            "level": "INFO",
            "propagate": false
        }
    }
}