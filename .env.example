# Global ENV
DEBUG=1
## Optional. Base host for pytest connection
BASE_HOST=app # app = docker
H3_RESOLUTION=8
RATE_LIMIT_THRESHOLD=5
## Optional. Pytest suite: smoke | e2e | integration (default: smoke)
# TEST_SUITE=smoke
## Optional. Comma separated test modules (tests/<suite>/<module>) to run / to skip
# TEST_MODULES=auth
# TEST_EXCLUDE_MODULES=

# Postgres Config ENV
POSTGRES_DB=postgres

DATABASE_SUPERUSER=postgres
DATABASE_SUPASSWORD=toor

DATABASE_USER=postuser
DATABASE_UPASSWORD=resu


# Redis Config ENV
REDIS_SUPASSWORD=toor
REDIS_USER=redis
REDIS_UPASSWORD=resu


# Backend Config ENV
## Uvicorn
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

## Security
SECRET_KEY=s3cR37....256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_CODE=008967

## Optionals
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFY_TOKEN_EXPIRE_MINUTES=60

## Redis
REDIS_HOST=redis        # redis = docker
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_USER}:${REDIS_UPASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

## Postgres
DB_HOST=db              # db = docker
DB_PORT=5432
CREDENTIALS_AND_CONNECTION=${DATABASE_USER}:${DATABASE_UPASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://${CREDENTIALS_AND_CONNECTION}

## DB migrations
ALEMBIC_URL=postgresql+asyncpg://${DATABASE_SUPERUSER}:${DATABASE_SUPASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
SQLACODEGEN_URL=postgresql://${CREDENTIALS_AND_CONNECTION}