# Global ENV
DEBUG=1
## Optional. Base host for pytest connection
BASE_HOST=app # app = docker
H3_RESOLUTION=8
RATE_LIMIT_THRESHOLD=5
## Optional. Pytest suite: smoke | e2e | integration (default: smoke)
# TEST_SUITE=smoke
## Optional. Comma separated test modules (tests/<suite>/<module>) to run / to skip
# TEST_MODULES=auth
# TEST_EXCLUDE_MODULES=

# Postgres Config ENV
POSTGRES_DB=postgres

DATABASE_SUPERUSER=postgres
DATABASE_SUPASSWORD=toor

DATABASE_USER=postuser
DATABASE_UPASSWORD=resu


# Redis Config ENV
REDIS_SUPASSWORD=toor
REDIS_USER=redis
REDIS_UPASSWORD=resu


# Storage Config ENV
## S3 credentials. Admin is used only by storage-init, app by the backend
STORAGE_ADMIN_KEY=storageadmin
STORAGE_ADMIN_SECRET=
STORAGE_APP_KEY=storageapp
STORAGE_APP_SECRET=
## Any long random strings. Losing STORAGE_SSE_KEY makes encrypted files unreadable
STORAGE_SSE_KEY=
STORAGE_FILER_JWT_KEY=


# Backend Config ENV
## Uvicorn
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

## Security
SECRET_KEY=s3cR37....256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_CODE=008967
## X-Admin-Key header for admin endpoints (geo-zone sync). Empty disables them
ADMIN_API_KEY=

## Optionals
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFY_TOKEN_EXPIRE_MINUTES=60

## Redis
REDIS_HOST=redis        # redis = docker
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_USER}:${REDIS_UPASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

## Storage
STORAGE_URL=http://storage:8333           # storage = docker
STORAGE_PUBLIC_URL=http://127.0.0.1:8333  # address used in presigned URLs

## Postgres
DB_HOST=db              # db = docker
DB_PORT=5432
CREDENTIALS_AND_CONNECTION=${DATABASE_USER}:${DATABASE_UPASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://${CREDENTIALS_AND_CONNECTION}

## PANSA DroneMap API
## Key: x-api-key sent by the dronemap.pansa.pl front-end
PANSA_API_KEY=
## Optional
# PANSA_API_URL=https://api.dronemap.pansa.pl
# PANSA_USER_AGENT=SkyDocker (university thesis project)

## Sync worker: cron runs in SYNC_TIMEZONE, an empty cron or 0 minutes disables the job
SYNC_TIMEZONE=Europe/Warsaw
## PANSA syncs, normal schedule: uncomment for the demo and production
# SYNC_CATALOG_CRON="0 3 * * *"
# SYNC_ACTIVITY_INTERVAL_MINUTES=360
## PANSA syncs disabled, so dev machines do not load the official API
SYNC_CATALOG_CRON=
SYNC_ACTIVITY_INTERVAL_MINUTES=0
## GADM country borders
SYNC_BORDER_CRON="0 4 1 * *"
## Pauses in minutes before retrying a sync whose data source failed, empty disables retries
SYNC_RETRY_DELAYS_MINUTES=5,15,45
SYNC_ACTIVITY_RETRY_DELAYS_MINUTES=15
## Sync what the database lacks when the worker starts, e.g. a new database
SYNC_RUN_ON_START=1

## DB migrations
ALEMBIC_URL=postgresql+asyncpg://${DATABASE_SUPERUSER}:${DATABASE_SUPASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
SQLACODEGEN_URL=postgresql://${CREDENTIALS_AND_CONNECTION}