{
    "tasks": [
        {
            "label": "Uvicorn: Run server app",
            "type": "shell",
            "command": "uv run uvicorn backend_src.main:app --host 0.0.0.0 --port 8000 --reload --log-config ./backend_src/logging.json",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Pytest: Run tests",
            "type": "shell",
            "command": "uv run pytest -v -x --capture=tee-sys --suite ${input:testSuite} ${input:testArgs}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "Docker: Run app container with build",
            "type": "shell",
            "command": "docker compose up --build app",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Docker: Run app container cached",
            "type": "shell",
            "command": "docker compose up app",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Docker: Run test environment",
            "type": "shell",
            "command": "docker compose run --build --rm -e TEST_SUITE=${input:testSuite} -e TEST_MODULES=${input:testModules} test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ],
    "inputs": [
        {
            "id": "testSuite",
            "type": "pickString",
            "description": "Test suite to run after smoke tests",
            "options": ["smoke", "e2e", "integration"],
            "default": "smoke"
        },
        {
            "id": "testArgs",
            "type": "promptString",
            "description": "Extra pytest args, e.g. --module auth / --exclude-module auth / -k login",
            "default": ""
        },
        {
            "id": "testModules",
            "type": "promptString",
            "description": "Comma separated modules to run, empty = all",
            "default": ""
        }
    ],
    "version": "2.0.0"
}