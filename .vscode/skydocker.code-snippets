	"SQLAlchemy DB Model": {
		"scope": "python",
		"prefix": "dbmodel",
		"body": [
			"class ${1:TableName}(Base):",
			"    __tablename__ = \"${2:tablename}\""
		]
	},
	"SQL EnumWithUnknown": {
		"scope": "python",
		"prefix": "EnumWithUnknown",
		"body": [
			"EnumWithUnknown(",
			"   ${1:ENUM},",
			"   name=\"${2:enum_sql}\",",
			"   unknown_value=${1:ENUM}.unknown",
        	")"
		]
	},
	"SQL Mapped collumn": {
		"scope": "python",
		"prefix": "Mapped",
		"body": [
			"${1:column_name}: Mapped[${2:mapped_type}] = mapped_column(${3:sql_type})"
		]
	},
	"Pydantic Schema": {
		"scope": "python",
		"prefix": "pyschema",
		"body": [
			"class ${1:SchemaName}(BaseModel):",
			"    pass"
		]
	}
}