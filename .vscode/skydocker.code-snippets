	"SQLAlchemy DB Model": {
		"scope": "python",
		"prefix": "dbmodel",
		"body": [
			"class ${1:TableName}(Base):",
			"    __tablename__ = \"${2:tablename}\""
		]
	},
	"SQL EnumWithUnknown": {
		"scope": "python",
		"prefix": "EnumWithUnknown",
		"body": [
			"EnumWithUnknown(",
			"   ${1:ENUM},",
			"   name=\"${2:enum_sql}\",",
			"   unknown_value=${1:ENUM}.unknown",
        	")"
		]
	},
	"SQL Mapped collumn": {
		"scope": "python",
		"prefix": "Mapped",
		"body": [
			"${1:column_name}: Mapped[${2:mapped_type}] = mapped_column(${3:sql_type})"
		]
	},
	"Pydantic Schema": {
		"scope": "python",
		"prefix": "pyschema",
		"body": [
			"class ${1:SchemaName}(BaseModel):",
			"    pass"
		]
	},
	"Router Pilot": {
		"scope": "python",
		"prefix": "@routerpilot",
		"body": [
			"@router.${1:router_method}(\"/${2:route}\", responce_model=${3:responce_model})",
			"async def ${4:def_name}(data: ${5:data}, pilot: Pilot = Depends(get_current_pilot_cookie), db: AsyncSession = Depends(get_db)):",
			"    return "
		]
	},
	"Endpoint documentation": {
		"scope": "python",
		"prefix": "docs",
		"body": [
			"${0:ENDPOINT} = {",
			"    \"summary\": \"\",",
			"    \"description\": \"\",",
			"    \"response_description\": \"\",",
			"    \"responses\": {",
			"        400: { \"description\": \"\" }",
			"    }",
			"}"
		]
	}
}